---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experiential Training">
	<main class="section">
		<div class="container panel about-panel" data-reveal>
			<h2>Experiential Training</h2>
			<p style="margin-top: -0.4rem; color: var(--text-secondary); line-height: 1.65; max-width: 900px;">
				Paramount World Records offers hands-on training programmes that prepare individuals, teams, and
				institutions for world record attempts—with the same discipline, evidence standards, and adjudication
				protocols used in official certification.
			</p>

			<div class="grid two" style="margin-top: 1.2rem;">
				<section class="panel" style="background: transparent; border: 1px solid rgba(196,194,188,0.3);" data-reveal>
					<h3 style="margin-bottom: 0.6rem; color: #c4c2bc;">Who it is for</h3>
					<ul class="suggestions" style="margin-top: 0;">
						<li>Yoga schools, dance academies, and fitness centres</li>
						<li>Corporate teams and community groups</li>
						<li>Event coordinators, chapter leaders, and volunteers</li>
						<li>Teachers, coaches, and aspiring record holders</li>
					</ul>
				</section>

				<section class="panel" style="background: transparent; border: 1px solid rgba(196,194,188,0.3);" data-reveal>
					<h3 style="margin-bottom: 0.6rem; color: #c4c2bc;">What you learn</h3>
					<ul class="suggestions" style="margin-top: 0;">
						<li>Record attempt planning and category selection</li>
						<li>Witness guidance, evidence capture, and compliance</li>
						<li>Group coordination for large-scale unified attempts</li>
						<li>Professional event conduct and post-attempt documentation</li>
					</ul>
				</section>
			</div>

			<p style="margin-top: 1.35rem; color: var(--text-secondary); line-height: 1.65; max-width: 900px;">
				Training is delivered through workshops, on-site sessions, and programme partnerships across our
				Mumbai headquarters and branch networks in Chennai, Coimbatore, and Kanchipuram.
			</p>

			<div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
				<a class="btn btn-primary" href="/contact">Enquire about training</a>
				<a class="btn btn-ghost" href="/apply">Apply for a record</a>
			</div>
		</div>
	</main>
</Layout>
