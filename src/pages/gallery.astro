---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";

/** Add albums below. Place files in `public/images/gallery/<folder>/`. */
type GalleryImage = { kind: "image"; src: string; alt: string };
type GalleryVideo = { kind: "video"; src: string; alt: string; poster?: string };

type GalleryFolder = {
	id: string;
	title: string;
	subtitle?: string;
	emptyMessage?: string;
	items: (GalleryImage | GalleryVideo)[];
};

function loadImagesFromFolder(folderId: string, altPrefix: string): GalleryImage[] {
	const dir = path.join(process.cwd(), "public/images/gallery", folderId);
	if (!fs.existsSync(dir)) return [];

	const files = fs
		.readdirSync(dir)
		.filter((file) => /\.(png|jpe?g|webp)$/i.test(file))
		.sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

	return files.map((file, i) => ({
		kind: "image" as const,
		src: `/images/gallery/${folderId}/${file}`,
		alt: `${altPrefix} (${i + 1} of ${files.length})`,
	}));
}

const amrapaliKathak = loadImagesFromFolder(
	"amrapali-kathak-world-record",
	"Amrapali Kathak Dance Academy — world record performance",
);

const ironHubFitness: GalleryImage[] = Array.from({ length: 18 }, (_, i) => {
	const n = String(i + 1).padStart(2, "0");
	return {
		kind: "image" as const,
		src: `/images/gallery/iron-hub-fitness-world-record/${n}.png`,
		alt: `Iron Hub — fitness world record event, trainers and trainees (${i + 1} of 18)`,
	};
});

const dreamersDanceAlt = [
	"Medal presentation to Master Sam Sukant Lenka at Dreamers Dance Studio",
	"Sam Sukant Lenka receiving world record certificate and medal",
	"World record holder with certificate and trophy at Dreamers Dance Studio",
	"Sam Sukant Lenka celebrating world record achievement at Dreamers Dance Studio",
	"Adult dancer receiving world record certificate at Dreamers Dance Studio",
	"Young dancers rehearsing Bollywood choreography at Dreamers Dance Studio",
	"Group dance practice session at Dreamers Dance and Fitness Studio",
	"Students performing synchronized dance moves during world record rehearsal",
	"Children practicing choreography led by instructor at Dreamers Dance Studio",
	"Adult dancers rehearsing group Bollywood routine at Dreamers Dance Studio",
	"Young girl receiving world record certificate at Dreamers Dance Studio event",
	"Award recipient with medal and certificate at Dreamers Dance Studio",
	"Certificate presentation for continuous Bollywood dance world record",
	"Young achiever holding Paramount World Records certificate at Dreamers Dance Studio",
	"Medal presentation at Dreamers Dance Studio world record event",
	"Young girl with world record certificate and medal at Dreamers Dance Studio",
	"Certificate of World Record Holder — Dreamers Dance and Fitness Studio",
	"Young dancer awarded world record certificate at Dreamers Dance Studio",
	"Group of young dancers rehearsing at Dreamers Dance Studio",
	"Children performing coordinated dance routine during world record attempt",
	"Students practicing Bollywood dance in studio with mirror wall",
	"Adult dancers rehearsing group choreography at Dreamers Dance Studio",
	"Young dancers in formation during world record rehearsal session",
	"Certificate presentation to young achiever at Dreamers Dance Studio",
	"World record certificate ceremony at Dreamers Dance Studio",
	"Young girl with medal and certificate at Dreamers Dance Studio event",
	"Group dance rehearsal at Dreamers Dance and Fitness Studio",
	"Students practicing synchronized Bollywood dance for world record attempt",
];

const dreamersDanceStudio: GalleryImage[] = Array.from({ length: 28 }, (_, i) => {
	const n = String(i + 1).padStart(2, "0");
	return {
		kind: "image" as const,
		src: `/images/gallery/dreamers-dance-studio-world-record/${n}.png`,
		alt: dreamersDanceAlt[i] ?? `Dreamers Dance Studio world record (${i + 1} of 28)`,
	};
});

const mothersDayAlt = [
	"Award recipient interviewed by media at the Motherlywood 2026 ceremony",
	"Group photo with award recipients at the Motherlywood 2026 celebration, Mumbai Press Club",
	"Award recipients holding recognition plaques at the Mother's Day ceremony",
	"Group of honourees with Mother's Day Special Recognition Awards 2026",
	"Recipients posing with Mother's Day recognition awards at Mumbai Press Club",
	"Award presentation at the Motherlywood 2026 Mother's Day celebration",
	"Honourees holding certificates at the Mother's Day Special Recognition Awards 2026",
	"Award recipient receiving a recognition plaque at the Motherlywood 2026 event",
	"Chief guest speaking at the podium, Mumbai Press Club",
	"Group portrait at the Motherlywood 2026 Mother's Day Awards & Celebration",
	"Media interview with an award recipient at the Mother's Day ceremony",
];

const mothersDayAwardCeremony: GalleryImage[] = Array.from({ length: 11 }, (_, i) => {
	const n = String(i + 1).padStart(2, "0");
	return {
		kind: "image" as const,
		src: `/images/gallery/mothers-day-award-ceremony/${n}.png`,
		alt: mothersDayAlt[i] ?? `Mother's Day Award Ceremony (${i + 1} of 11)`,
	};
});

const upcomingEvents: GalleryImage[] = [
	{
		kind: "image" as const,
		src: "/images/gallery/upcoming-events/international-yoga-day-world-record-2026.png",
		alt: "Paramount World Records — International Yoga Day World Record Attempt 2026, 21 June 2026, India & global participation",
	},
];

const folders: GalleryFolder[] = [
	{
		id: "amrapali-kathak-world-record",
		title: "Amrapali Kathak World Record",
		subtitle:
			"Continuous Kathak dance performance by a unified group — certificates, group portraits, and celebration moments (26 April 2026).",
		items: amrapaliKathak,
	},
	{
		id: "iron-hub-fitness-world-record",
		title: "Iron Hub Fitness World Record",
		subtitle:
			"Iron Hub Gym, J.B. Nagar — Paramount World Records fitness event (3 May 2026). Posters, certificates, training moments, and team photos.",
		items: ironHubFitness,
	},
	{
		id: "dreamers-dance-studio-world-record",
		title: "Dreamers Dance Studio World Record",
		subtitle:
			"Continuous Bollywood dance by a unified group — Dreamers Dance and Fitness Studio. Rehearsals, certificates, medals, and celebration moments.",
		items: dreamersDanceStudio,
	},
	{
		id: "mothers-day-award-ceremony",
		title: "Mother's Day Award Ceremony",
		subtitle:
			"Motherlywood 2026 — Mother's Day Awards & Celebration at Mumbai Press Club, Fort. Recognition awards, group portraits, and ceremony moments.",
		items: mothersDayAwardCeremony,
	},
	{
		id: "upcoming-events",
		title: "Upcoming Events",
		subtitle: "Flyers and announcements for upcoming Paramount World Records programmes.",
		items: upcomingEvents,
	},
];
---

<Layout title="Gallery — Paramount World Records">
	<main class="section gallery-page">
		<header class="container gallery-page-header" data-reveal>
			<p class="tag">Media</p>
			<h1>Gallery</h1>
		</header>

		<div class="container gallery-folders" data-reveal>
			{
				folders.map((folder) => (
					<details class="gallery-folder panel card-gloss">
						<summary class="gallery-folder-summary">
							<span class="gallery-folder-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path
										d="M3 7.5C3 6.67157 3.67157 6 4.5 6H9.17157C9.70201 6 10.2107 6.21071 10.5858 6.58579L12 8H19.5C20.3284 8 21 8.67157 21 9.5V17.5C21 18.3284 20.3284 19 19.5 19H4.5C3.67157 19 3 18.3284 3 17.5V7.5Z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
							<span class="gallery-folder-text">
								<span class="gallery-folder-title">{folder.title}</span>
								{folder.subtitle ? (
									<span class="gallery-folder-sub">{folder.subtitle}</span>
								) : null}
							</span>
							<span class="gallery-folder-count">
								{folder.items.length > 0
									? `${folder.items.length} ${folder.items.length === 1 ? "item" : "items"}`
									: "Empty"}
							</span>
							<span class="gallery-folder-chevron" aria-hidden="true" />
						</summary>

						<div class="gallery-folder-body">
							{folder.items.length > 0 ? (
								<div class="grid three gallery-grid">
									{folder.items.map((item) => (
										<figure class="panel card-gloss gallery-cell">
											{item.kind === "image" ? (
												<button
													type="button"
													class="gallery-thumb-btn"
													aria-label={`Open larger: ${item.alt}`}
												>
													<img
														class="gallery-media"
														src={item.src}
														alt={item.alt}
														loading="lazy"
														decoding="async"
														data-gallery-image
													/>
												</button>
											) : (
												<video
													class="gallery-media gallery-video"
													src={item.src}
													controls
													playsinline
													preload="metadata"
													poster={item.poster}
													aria-label={item.alt}
												/>
											)}
										</figure>
									))}
								</div>
							) : (
								<p class="gallery-folder-empty">{folder.emptyMessage ?? "No photos yet."}</p>
							)}
						</div>
					</details>
				))
			}
		</div>

		<dialog id="gallery-lightbox" class="gallery-lightbox" aria-label="Enlarged photo">
			<button type="button" class="gallery-lightbox-close" autofocus>Close</button>
			<img id="gallery-lightbox-img" src="" alt="" class="gallery-lightbox-img" />
		</dialog>
	</main>
</Layout>

<script>
	const dialog = document.getElementById("gallery-lightbox");
	const imgEl = document.getElementById("gallery-lightbox-img");

	document.querySelectorAll("[data-gallery-image]").forEach((node) => {
		node.addEventListener("click", (e) => {
			const t = e.currentTarget;
			if (!(t instanceof HTMLImageElement) || !dialog || !imgEl) return;
			imgEl.src = t.currentSrc || t.src;
			imgEl.alt = t.alt;
			dialog.showModal();
		});
	});

	dialog?.addEventListener("click", (e) => {
		if (e.target === dialog) dialog.close();
	});

	document.querySelector(".gallery-lightbox-close")?.addEventListener("click", () => dialog?.close());

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && dialog?.open) dialog.close();
	});
</script>

<style>
	.gallery-page-header {
		max-width: 42rem;
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.gallery-page-header h1 {
		margin: 0.35rem 0 0.75rem;
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.gallery-folders {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.gallery-folder {
		overflow: hidden;
	}

	.gallery-folder-summary {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.25rem;
		cursor: pointer;
		list-style: none;
	}

	.gallery-folder-summary::-webkit-details-marker {
		display: none;
	}

	.gallery-folder-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 12px;
		background: rgba(29, 43, 107, 0.08);
		color: var(--accent, #1d2b6b);
		flex-shrink: 0;
	}

	.gallery-folder-icon svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.gallery-folder-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.gallery-folder-title {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-primary, #0f172a);
	}

	.gallery-folder-sub {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--text-secondary, #475569);
	}

	.gallery-folder-count {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--text-secondary, #64748b);
		white-space: nowrap;
	}

	.gallery-folder-chevron {
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid var(--text-secondary, #64748b);
		border-bottom: 2px solid var(--text-secondary, #64748b);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
		flex-shrink: 0;
	}

	.gallery-folder[open] .gallery-folder-chevron {
		transform: rotate(-135deg);
		margin-top: 0.25rem;
	}

	.gallery-folder-body {
		padding: 0 1.25rem 1.35rem;
		border-top: 1px solid var(--border-subtle, #e2e8f0);
	}

	.gallery-folder-empty {
		margin: 1.25rem 0 0.35rem;
		padding: 1.25rem 1rem;
		border-radius: var(--radius-card, 16px);
		background: var(--surface-muted, #f8fafc);
		color: var(--text-secondary, #64748b);
		font-size: 0.95rem;
		text-align: center;
	}

	.gallery-grid {
		gap: 1.25rem;
		margin-top: 1.25rem;
	}

	.gallery-grid .gallery-cell:only-child {
		max-width: min(100%, 980px);
		margin-inline: auto;
	}

	.gallery-grid .gallery-cell:only-child .gallery-media {
		height: auto;
		max-height: none;
		object-fit: contain;
	}

	.gallery-cell {
		padding: 0.35rem;
		margin: 0;
		overflow: hidden;
	}

	.gallery-thumb-btn {
		display: block;
		width: 100%;
		padding: 0;
		margin: 0;
		border: none;
		background: none;
		cursor: zoom-in;
		border-radius: var(--radius-card, 16px);
	}

	.gallery-media {
		display: block;
		width: 100%;
		height: 220px;
		object-fit: cover;
		border-radius: var(--radius-card, 16px);
		background: var(--surface-muted, #f8fafc);
		vertical-align: middle;
		transition: transform 0.35s ease, box-shadow 0.35s ease;
	}

	.gallery-thumb-btn:hover .gallery-media,
	.gallery-thumb-btn:focus-visible .gallery-media {
		transform: scale(1.02);
		box-shadow: var(--shadow-soft-sm, 0 8px 28px rgba(15, 23, 42, 0.1));
	}

	.gallery-thumb-btn:focus-visible {
		outline: 2px solid var(--accent, #1d2b6b);
		outline-offset: 3px;
	}

	.gallery-video {
		object-fit: contain;
		height: auto;
		min-height: 220px;
		max-height: 340px;
	}

	.gallery-lightbox {
		border: none;
		padding: 0;
		max-width: min(96vw, 1100px);
		background: transparent;
	}

	.gallery-lightbox::backdrop {
		background: rgba(15, 23, 42, 0.88);
		backdrop-filter: blur(4px);
	}

	.gallery-lightbox-img {
		display: block;
		max-width: min(92vw, 1000px);
		max-height: min(86vh, 900px);
		width: auto;
		height: auto;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
	}

	.gallery-lightbox-close {
		position: fixed;
		top: 1.25rem;
		right: 1.25rem;
		z-index: 2;
		border: 1px solid rgba(255, 255, 255, 0.35);
		background: rgba(15, 23, 42, 0.6);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
		padding: 0.5rem 0.9rem;
		border-radius: 9999px;
		cursor: pointer;
	}

	@media (max-width: 640px) {
		.gallery-folder-summary {
			grid-template-columns: auto 1fr auto;
			grid-template-rows: auto auto;
		}

		.gallery-folder-count {
			grid-column: 2;
			grid-row: 2;
			justify-self: start;
			margin-left: 0;
		}

		.gallery-folder-chevron {
			grid-column: 3;
			grid-row: 1 / span 2;
			align-self: center;
		}
	}
</style>
